{
  "manifest_version": 3,
  "name": "Translator Extension",
  "description": "Extension Navigator Translator",
  "version": "1.0",
  "action": {
    "default_popup": "index.html",
    "default_title": "Translator Extension",
    "default_icon": "logo.png"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ]
    }
  ]
}